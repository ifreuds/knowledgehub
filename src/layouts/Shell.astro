---
// The LIVING shell — ornate hub chrome only (header, game toggle, search, footer).
// Restyle freely; it never touches frozen content bodies. Theme tokens: src/styles/codex.css
import '../styles/codex.css';
import { GAMES, GAME_ORDER } from '../config';
interface Props { game: string; title?: string }
const { game, title } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · The Codex` : 'The Codex · PoE Compendium'}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Mulish:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="codex-backdrop" aria-hidden="true"></div>
  <div class="codex-page">
    <header class="codex-header">
      <div class="wrap hdr">
        <a href={`/${game}`} class="brand">
          <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="#c8a04f" stroke-width="1.2" style="filter:drop-shadow(0 0 6px rgba(200,160,79,.3))">
            <path d="M16 1.5 L30.5 16 L16 30.5 L1.5 16 Z"></path>
            <path d="M16 8 L24 16 L16 24 L8 16 Z" stroke-opacity="0.55"></path>
            <circle cx="16" cy="16" r="1.7" fill="#c8a04f" stroke="none"></circle>
          </svg>
          <span class="brand-txt">
            <span class="brand-title">THE&nbsp;CODEX</span>
            <span class="brand-sub">PATH&nbsp;OF&nbsp;EXILE&nbsp;COMPENDIUM</span>
          </span>
        </a>
        <nav class="toggle">
          {GAME_ORDER.map((g) => (
            <a href={`/${g}`} class={`toggle-btn ${g === game ? 'active' : ''}`}>{GAMES[g].label}</a>
          ))}
        </nav>
        <div class="search">
          <svg class="search-ico" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
          <input id="hub-search" type="search" placeholder="Search the Codex…" autocomplete="off" />
        </div>
      </div>
    </header>

    <main class="wrap codex-main"><slot /></main>

    <footer class="codex-footer">
      <div class="wrap ftr">
        <span class="ftr-brand">
          <svg width="18" height="18" viewBox="0 0 32 32" fill="none" stroke="#8a6f3a" stroke-width="1.3"><path d="M16 2 L30 16 L16 30 L2 16 Z"></path></svg>
          <span>THE CODEX</span>
        </span>
        <span class="ftr-note">A personal Path of Exile compendium · not affiliated with Grinding Gear Games</span>
        <span class="ftr-spacer"></span>
        <span class="ftr-sync">frozen per league</span>
      </div>
    </footer>
  </div>

  <style>
    .codex-page { position:relative; z-index:1; min-height:100vh; display:flex; flex-direction:column; }
    .codex-main { flex:1; padding-bottom:60px; }

    .codex-header { position:sticky; top:0; z-index:30; background:rgba(13,14,17,.86); backdrop-filter:blur(12px); border-bottom:1px solid var(--line-gold); }
    .hdr { display:flex; flex-wrap:wrap; align-items:center; gap:14px 22px; padding-top:13px; padding-bottom:13px; }
    .brand { display:flex; align-items:center; gap:12px; margin-right:auto; }
    .brand-txt { display:flex; flex-direction:column; gap:2px; }
    .brand-title { font-family:var(--f-display); font-weight:700; font-size:19px; letter-spacing:.20em; color:var(--bone); line-height:1; }
    .brand-sub { font-family:var(--f-mono); font-size:9px; letter-spacing:.24em; color:var(--gold-deep); line-height:1; }
    .toggle { display:inline-flex; padding:3px; gap:3px; background:#141519; border:1px solid var(--line-gold); border-radius:9px; flex:none; }
    .toggle-btn { padding:7px 16px; border-radius:6px; font-family:var(--f-mono); font-weight:500; font-size:13px; letter-spacing:.03em; color:#9a958a; transition:.15s; }
    .toggle-btn.active { background:var(--gold); color:#1a1206; }
    .toggle-btn:not(.active):hover { color:var(--bone); }
    .search { position:relative; flex:1 1 220px; max-width:340px; min-width:170px; }
    .search-ico { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--muted-2); display:flex; pointer-events:none; }
    .search input { width:100%; padding:9px 12px 9px 35px; background:#121317; border:1px solid rgba(255,255,255,.10); border-radius:8px; color:var(--bone); font-family:var(--f-body); font-size:13.5px; outline:none; transition:.15s; }
    .search input:focus { border-color:rgba(200,160,79,.55); background:#15161b; }

    .codex-footer { border-top:1px solid rgba(200,160,79,.2); background:rgba(10,11,13,.6); }
    .ftr { display:flex; flex-wrap:wrap; align-items:center; gap:14px 24px; padding-top:26px; padding-bottom:26px; }
    .ftr-brand { display:flex; align-items:center; gap:10px; font-family:var(--f-display); font-weight:600; font-size:13px; letter-spacing:.16em; color:var(--gold-dim); }
    .ftr-note { font-family:var(--f-body); font-size:12px; color:var(--muted-2); }
    .ftr-spacer { flex:1; }
    .ftr-sync { font-family:var(--f-mono); font-size:11px; color:var(--faint); letter-spacing:.04em; }
  </style>
</body>
</html>
